---
import { ICON_CONFIG } from '../config/site';

export interface Props {
  name:
    | 'compass'
    | 'upload'
    | 'map-pin'
    | 'mountain'
    | 'star'
    | 'download'
    | 'check'
    | 'arrow-right'
    | 'activity';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={ICON_CONFIG.viewBox}
  fill="none"
  stroke="currentColor"
  stroke-width={ICON_CONFIG.strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
    </>
  )}
  {name === 'upload' && (
    <>
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="17 8 12 3 7 8" />
      <line x1="12" y1="3" x2="12" y2="15" />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === 'mountain' && (
    <>
      <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
      <path d="M4.14 15.08c2.62-1.57 5.24-1.43 7.86.42 2.74 1.94 5.49 2 8.23.19" />
    </>
  )}
  {name === 'star' && (
    <polygon
      points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
      fill="currentColor"
    />
  )}
  {name === 'download' && (
    <>
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </>
  )}
  {name === 'check' && <polyline points="20 6 9 17 4 12" />}
  {name === 'arrow-right' && (
    <>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </>
  )}
  {name === 'activity' && <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />}
</svg>
