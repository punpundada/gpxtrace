---
import 'leaflet/dist/leaflet.css';
import '../styles/design-system.css';
import Header from '../components/Header.astro';
import { SITE_CONFIG, withBase } from '../config/site';

export interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedDate?: string;
  category?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${SITE_CONFIG.name} — ${SITE_CONFIG.tagline}`,
  description = SITE_CONFIG.heroSubheadline,
  ogType = 'website',
  publishedDate,
  category,
  jsonLd,
} = Astro.props;

const siteOrigin = new URL(Astro.site?.toString() || SITE_CONFIG.siteUrl).origin;
const canonicalPath =
  Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.')
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const ogImageUrl = new URL(SITE_CONFIG.ogImagePath, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={SITE_CONFIG.faviconPath} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={withBase('/sitemap.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_CONFIG.name} RSS Feed`}
      href={withBase('/rss.xml')}
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content={SITE_CONFIG.themeColor} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {ogType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    {ogType === 'article' && category && (
      <meta property="article:section" content={category} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container site-footer-inner">
        <div>
          <strong>{SITE_CONFIG.name}</strong> — {SITE_CONFIG.tagline}
        </div>
        <div>
          Maps &copy; OpenStreetMap &amp; OpenTopoMap contributors ·{' '}
          <a href={withBase('/rss.xml')} class="nav-link">RSS Feed</a>
        </div>
      </div>
    </footer>

    <script>
      import { applyUnitSystem, getActiveUnit } from '../lib/units';

      applyUnitSystem(getActiveUnit());

      document.querySelectorAll<HTMLButtonElement>('[data-unit-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const chosen = btn.dataset.unitToggle === 'imperial' ? 'imperial' : 'metric';
          applyUnitSystem(chosen);
        });
      });
    </script>
  </body>
</html>
